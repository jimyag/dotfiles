{{- if eq .chezmoi.os "linux" -}}
#!/bin/bash
set -euo pipefail

if ! command -v docker >/dev/null 2>&1; then
    installer="$(mktemp)"
    trap 'rm -f "$installer"' EXIT
    curl -fsSL https://get.docker.com -o "$installer"
    sudo sh "$installer"
fi
if [ -d /run/systemd/system ]; then
    sudo systemctl enable --now docker
fi
{{- end -}}
