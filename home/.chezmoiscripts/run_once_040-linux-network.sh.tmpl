{{- if eq .chezmoi.os "linux" -}}
#!/bin/bash
set -euo pipefail

# Keep forwarding settings in a drop-in; recent distributions may omit sysctl.conf.
printf '%s\n' 'net.ipv4.ip_forward = 1' 'net.ipv6.conf.all.forwarding = 1' |
  sudo tee /etc/sysctl.d/99-dotfiles-forwarding.conf >/dev/null
if [ -d /run/systemd/system ]; then
  sudo sysctl -p /etc/sysctl.d/99-dotfiles-forwarding.conf
else
  echo "Forwarding configuration saved; live sysctl changes require a host session." >&2
fi

# WSL2 上不安装 Tailscale / ZeroTier
if grep -qi microsoft /proc/version 2>/dev/null; then
  echo "WSL2 detected; skipping Tailscale and ZeroTier installation." >&2
else
  # Tailscale
  if ! command -v tailscale >/dev/null 2>&1; then
    curl -fsSL https://tailscale.com/install.sh | sh
  fi

  # ZeroTier
  if ! command -v zerotier-cli >/dev/null 2>&1; then
    curl -fsSL https://install.zerotier.com | sudo bash
  fi
fi
{{- end -}}
