{{- if ne .chezmoi.os "linux" -}}
#!/bin/bash
set -euo pipefail

# Chezmoi does not traverse directory symlinks in its source state.
skills_source="{{ .chezmoi.sourceDir }}/dot_agents/skills"
if [ -L "$skills_source" ]; then
    mkdir -p "$HOME/.agents/skills"
    # ponytail: removed source files remain; track installed paths if cleanup is needed.
    cp -R "$skills_source/." "$HOME/.agents/skills/"
fi
{{- end -}}
