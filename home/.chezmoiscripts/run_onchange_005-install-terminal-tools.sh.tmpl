#!/bin/bash
set -euo pipefail

export PATH="$HOME/.local/bin:$PATH"
{{ if eq .chezmoi.os "darwin" -}}
for tool in starship fzf eza bat yazi; do
    if ! command -v "$tool" >/dev/null 2>&1; then
        jd "$tool"
    fi
done
{{ else if eq .chezmoi.os "linux" -}}
if command -v starship >/dev/null 2>&1; then
    exit 0
fi
jd starship
{{ end -}}
